<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema escuro inspirado no Windows 11 (Mica escuro). -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#191919" />
    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#262626" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C2C2C2" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8F8F8F" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#333333" />
    <SolidColorBrush x:Key="TrackBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F58A2A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9B40" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#333333" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ChartStrokeBrush" Color="#F58A2A" />
    <SolidColorBrush x:Key="ChartFillBrush" Color="#26F58A2A" />
    <SolidColorBrush x:Key="ChartStroke2Brush" Color="#4CA0E0" />
    <SolidColorBrush x:Key="ChartFill2Brush" Color="#264CA0E0" />

    <!-- logo1.jpg (fundo claro) é exibida como "selo" sobre o tema escuro, onde a logo2 perderia contraste. -->
    <BitmapImage x:Key="LogoImage" UriSource="/Assets/logo1.jpg" DecodePixelWidth="480" />
</ResourceDictionary>
