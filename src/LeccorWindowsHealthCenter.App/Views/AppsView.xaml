<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:AppsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Atualizar"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Aplicativos Instalados" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Inventário completo de programas Win32 e Microsoft Store, detecção de desinstaladores órfãos e versões redundantes." />
                </StackPanel>
            </DockPanel>

            <!-- Cards de Resumo -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="TOTAL DE PROGRAMAS" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TotalAppsCount}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Programas inventariados" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="WIN32 (DESKTOP)" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Win32AppsCount}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Instaladores clássicos" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="MICROSOFT STORE" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding StoreAppsCount}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Pacotes UWP / MSIX" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="REQUER ATENÇÃO" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding OrphanedCount}" Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Desinstaladores órfãos" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Barra de Filtros e Busca -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Pesquisar aplicativo por nome ou fabricante..."
                             Height="34" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              Width="180" Height="34" VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- Lista e Detalhes Master-Detail -->
            <Grid MinHeight="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Coluna Esquerda: Lista de Aplicativos -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="0">
                    <ListBox ItemsSource="{Binding FilteredApps}"
                             SelectedItem="{Binding SelectedApp}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="Transparent"
                             MaxHeight="580">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AppRowViewModel}">
                                <Border Padding="12,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Publisher}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                <TextBlock Style="{StaticResource Caption}" Text=" · Versão " Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Version}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CriticalBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasDuplicateVersion}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Coluna Direita: Detalhes do Aplicativo -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedApp}">
                            <TextBlock Style="{StaticResource Subheading}" Text="{Binding DisplayName, TargetNullValue='Selecione um aplicativo'}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Publisher}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,16" />

                            <TextBlock Style="{StaticResource Caption}" Text="TIPO / ORIGEM" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding SourceText}" Margin="0,2,0,12" />

                            <TextBlock Style="{StaticResource Caption}" Text="VERSÃO" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Version}" Margin="0,2,0,12" />

                            <TextBlock Style="{StaticResource Caption}" Text="DATA DE INSTALAÇÃO" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding InstallDateText}" Margin="0,2,0,12" />

                            <TextBlock Style="{StaticResource Caption}" Text="TAMANHO ESTIMADO EM DISCO" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding SizeText}" Margin="0,2,0,12" />

                            <TextBlock Style="{StaticResource Caption}" Text="PASTA DE INSTALAÇÃO" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding InstallLocation}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Abrir Pasta no Explorer"
                                    Command="{Binding DataContext.OpenInstallLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Left" Margin="0,0,0,16" />

                            <TextBlock Style="{StaticResource Caption}" Text="COMANDO DE DESINSTALAÇÃO" FontWeight="SemiBold" />
                            <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="8" Margin="0,4,0,8">
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding UninstallCommand}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" />
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Content="Copiar Comando"
                                    Command="{Binding DataContext.CopyUninstallStringCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

