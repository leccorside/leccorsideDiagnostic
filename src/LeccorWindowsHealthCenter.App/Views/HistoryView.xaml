<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="FindingTemplate" DataType="{x:Type vm:FindingItemViewModel}">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                <Expander Padding="16,4,16,16">
                    <Expander.Header>
                        <DockPanel Margin="4,8">
                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource SeverityDot}" Tag="{Binding Severity}" Margin="0,0,12,0" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding ConfidenceText}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SemanticText}" Tag="{Binding Severity}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding SeverityText}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel Margin="26,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="O que aconteceu?" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding WhatHappened}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Como sabemos disso?" />
                        <ItemsControl ItemsSource="{Binding Evidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EvidenceLine}">
                                    <StackPanel Margin="0,1">
                                        <TextBlock Style="{StaticResource Body}">
                                            <Run Text="•" /> <Run Text="{Binding Text, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" Margin="12,0,0,0" Text="{Binding Technical}"
                                                   Visibility="{Binding DataContext.Preferences.AdvancedMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding ProbableCause, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Causa provável" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding ProbableCause}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Qual o impacto?" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Impact}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Como corrigir?" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Recommendation}" />
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1100">
            <!-- Modo 1: Lista do histórico -->
            <StackPanel Visibility="{Binding ViewingScanReport, Converter={StaticResource VisibleWhenFalse}}">
                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Atualizar"
                            Command="{Binding RefreshCommand}" AutomationProperties.Name="Atualizar histórico de varreduras" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Histórico de Varreduras" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Registro completo das varreduras de saúde realizadas anteriormente neste computador." />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding EmptyMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Body}" Text="{Binding EmptyMessage}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Scans}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScanHistoryItemViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Ver laudo"
                                            VerticalAlignment="Center" Margin="16,0,0,0"
                                            Command="{Binding DataContext.ViewReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Ver laudo completo desta varredura" />

                                    <Border DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,20,0"
                                            CornerRadius="32" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="2" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Style="{StaticResource Body}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding ScoreText}" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center" Text="{Binding RatingText}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding ModeText}" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DateText}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding ResultsText}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding CoverageText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Modo 2: Visualização de laudo passado -->
            <StackPanel Visibility="{Binding ViewingScanReport, Converter={StaticResource VisibleWhen}}">
                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="← Voltar para a lista"
                            Command="{Binding BackToListCommand}" Margin="0,0,16,0"
                            AutomationProperties.Name="Voltar para a lista do histórico de varreduras" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Laudo da Varredura Anterior" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding SelectedScan.DateText}" />
                    </StackPanel>
                </DockPanel>

                <!-- Resumo da varredura selecionada -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="72" Height="72" Margin="0,0,20,0"
                                CornerRadius="36" BorderThickness="2" BorderBrush="{DynamicResource CardBorderBrush}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding SelectedScan.ScoreText}" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center" Text="{Binding SelectedScan.RatingText}" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedScan.ModeText}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="{Binding SelectedScan.ResultsText}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding SelectedScan.CoverageText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Problemas -->
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,8,0,8" Text="Problemas Detectados" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource FindingTemplate}" />

                <!-- Recomendações -->
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Text="Recomendações e Informações" />
                <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource FindingTemplate}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

