<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Conexões do Windows"
                            Command="{Binding OpenNetworkConnectionsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Testar Conectividade"
                            Command="{Binding RunDiagnosticsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Atualizar"
                            Command="{Binding RefreshAdaptersCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Rede e Conectividade" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Status de adaptadores físicos e virtuais (Wi-Fi, Ethernet, VPN, Docker, WSL), latência e resolução DNS." />
                </StackPanel>
            </DockPanel>

            <!-- Painel de Diagnóstico de Qualidade da Conexão -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInternet}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource CriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Subheading}" Text="{Binding InternetStatusText}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="DIAGNÓSTICO EM TEMPO REAL" Foreground="{DynamicResource TextMutedBrush}" />
                    </DockPanel>

                    <UniformGrid Columns="4" Margin="0,4,0,0">
                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="12,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="GATEWAY LOCAL" />
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding GatewayLatencyText}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="Latência do roteador" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="12,10" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="RESOLUÇÃO DNS" />
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding DnsResolutionText}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="Tempo de consulta" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="12,10" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="INTERNET PÚBLICA" />
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding PublicLatencyText}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="Latência média externa" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="12,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="PERDA DE PACOTES" />
                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding PacketLossText}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="Integridade da conexão" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Alertas do Diagnóstico se houver -->
                    <ItemsControl ItemsSource="{Binding DiagnosticAlerts}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="10,6" Margin="0,2">
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Lista de Adaptadores de Rede -->
            <TextBlock Style="{StaticResource Subheading}" Text="Adaptadores e Interfaces de Rede" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NetworkAdapterRowViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding Name}" Margin="0,0,8,0" />
                                        <Border CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Background="{DynamicResource CardAltBrush}">
                                            <TextBlock Text="{Binding CategoryText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Detalhes de IP / Gateway / DNS / MAC -->
                                <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="ENDEREÇO IP (IPv4)" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Ipv4Text}" FontFamily="Consolas" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,4,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="GATEWAY PADRÃO" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding GatewayText}" FontFamily="Consolas" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,4,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="SERVIDORES DNS" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DnsText}" FontFamily="Consolas" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="VELOCIDADE / MAC" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding SpeedText, Mode=OneWay}" /> · <Run Text="{Binding MacAddress, Mode=OneWay}" FontFamily="Consolas" />
                                        </TextBlock>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

