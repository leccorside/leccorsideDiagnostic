<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance Type=vm:EventsViewModel}">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Content="Atualizar"
                        Command="{Binding RefreshCommand}" AutomationProperties.Name="Atualizar lista de eventos" />
                <Button Style="{StaticResource SecondaryButton}" Content="Abrir no Visualizador do Windows"
                        Command="{Binding OpenEventViewerCommand}" AutomationProperties.Name="Abrir utilitário eventvwr.msc do Windows" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Eventos do Sistema" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Eventos significativos das últimas 24 horas (System, Application, Setup, WHEA e Windows Update) agrupados por origem e ID." />
            </StackPanel>
        </DockPanel>

        <!-- Barra de Filtros e Busca -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Nível:" />
                <ComboBox Width="160" ItemsSource="{Binding LevelFilters}" SelectedItem="{Binding SelectedLevelFilter}" />
            </StackPanel>
            <TextBox Style="{StaticResource ModernTextBox}" Width="320" HorizontalAlignment="Left"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Pesquisar eventos por origem, ID ou texto" />
        </DockPanel>

        <!-- Card de Resumo -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding SummaryText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Master-Detail Grid -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Lista de Grupos de Eventos (Coluna Esquerda) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ListBox ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EventGroupItemViewModel}">
                            <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding HeaderText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SubtitleText}" Margin="0,2,0,4" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Message}" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center" Padding="8,4">
                                        <TextBlock Style="{StaticResource Caption}" FontWeight="Bold" Text="{Binding Level}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Detalhes do Evento Selecionado (Coluna Direita) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Copiar"
                                    Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.Name="Copiar detalhes do evento para a área de transferência" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding HeaderText}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding LogName}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Nível e Ocorrências" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding SubtitleText}" Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Recurso ou Alvo" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding TargetResource, TargetNullValue='Geral / Sistema'}" Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Descrição do Evento" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <Expander Style="{StaticResource ModernExpander}" Header="Detalhes Técnicos / XML"
                                  Visibility="{Binding DataContext.Preferences.AdvancedMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}">
                            <TextBox Style="{StaticResource ModernTextBox}" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"
                                     IsReadOnly="True" TextWrapping="Wrap" MaxHeight="250" VerticalScrollBarVisibility="Auto" Text="{Binding Details}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

