<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Gerenciador de Dispositivos"
                            Command="{Binding OpenDeviceManagerCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Atualizar"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Drivers e Dispositivos" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Inventário de hardware Plug and Play, integridade dos drivers e identificação de erros de dispositivo." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding SummaryText}" />
                </StackPanel>
            </DockPanel>

            <!-- Card Destaque: Dispositivos com Erro / Driver Ausente (Se houver) -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="1.5"
                    Margin="0,0,0,20" Visibility="{Binding ProblemDevices.Count, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Background="{DynamicResource CriticalBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Text="DISPOSITIVOS COM ATENÇÃO" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="{Binding ProblemDevices.Count, Mode=OneWay}" /> <Run Text="dispositivo(s) requerem atenção" />
                        </TextBlock>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding ProblemDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriverDeviceRowViewModel}">
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusMessage}" Foreground="{DynamicResource CriticalBrush}" Margin="0,2,0,0" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DeviceId}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource SemanticText}" FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center" Tag="Critical"
                                                   Text="{Binding StatusCode, StringFormat={}Código {0}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Tabela Principal de Dispositivos -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Filtros e Busca -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Pesquisar por dispositivo, fabricante ou classe..." />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Content="Todas" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Todas}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Com Erro" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Com Erro}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Vídeo" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Vídeo}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Áudio" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Áudio}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Rede" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Rede}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Armazenamento" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Armazenamento}"
                                         VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ListView ItemsSource="{Binding FilteredDevices}" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Dispositivo" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverDeviceRowViewModel}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource CriticalBrush}"
                                                         Visibility="{Binding IsProblem, Converter={StaticResource VisibleWhen}}" />
                                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Classe" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverDeviceRowViewModel}">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding ClassName}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Fabricante" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverDeviceRowViewModel}">
                                            <TextBlock Style="{StaticResource Body}" Text="{Binding Manufacturer}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Versão do Driver" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverDeviceRowViewModel}">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DriverVersion}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Data" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverDeviceRowViewModel}">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DriverDateText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Status" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverDeviceRowViewModel}">
                                            <TextBlock Style="{StaticResource Body}" FontSize="12"
                                                       Text="{Binding StatusMessage}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

