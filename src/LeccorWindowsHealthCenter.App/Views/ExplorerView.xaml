<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:ExplorerViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Atualizar"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Windows Explorer" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Diagnóstico de extensões de Shell, caches de miniaturas e benchmark de pastas lentas." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding CacheStatusText}" />
                </StackPanel>
            </DockPanel>

            <!-- Detector de Pastas Lentas (Seção 17 do PROMPT) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Detector de Pastas Lentas" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="Mede o tempo real de enumeração, leitura de metadados e identifica gargalos de renderização (muitos arquivos, nuvem, antivírus)." />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding SelectedFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Procurar..."
                                Command="{Binding SelectFolderCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Executar Benchmark"
                                Command="{Binding RunBenchmarkCommand}" IsEnabled="{Binding IsBenchmarking, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Caption}" Text="Atalhos rápidos:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Downloads" Padding="8,4" Margin="0,0,6,0"
                                Command="{Binding QuickSelectCommand}" CommandParameter="Downloads" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Documentos" Padding="8,4" Margin="0,0,6,0"
                                Command="{Binding QuickSelectCommand}" CommandParameter="Documentos" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Imagens" Padding="8,4" Margin="0,0,6,0"
                                Command="{Binding QuickSelectCommand}" CommandParameter="Imagens" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Área de Trabalho" Padding="8,4"
                                Command="{Binding QuickSelectCommand}" CommandParameter="Desktop" />
                    </StackPanel>

                    <!-- Progresso do Benchmark -->
                    <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,4,0,8"
                                 Visibility="{Binding IsBenchmarking, Converter={StaticResource VisibleWhen}}" />

                    <!-- Resultado do Benchmark -->
                    <Border Background="{DynamicResource CardAltBrush}" CornerRadius="6" Padding="14" Margin="0,6,0,0"
                            Visibility="{Binding BenchmarkResult, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="RESULTADO DO BENCHMARK" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                                <TextBlock Style="{StaticResource SemanticText}" FontSize="13" FontWeight="Bold" DockPanel.Dock="Right"
                                           Tag="{Binding BenchmarkResult.HasPerformanceIssue}"
                                           Text="{Binding BenchmarkResult.TotalDuration.TotalMilliseconds, StringFormat={}{0:N0} ms total}" />
                            </DockPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="Enumeração" />
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                                               Text="{Binding BenchmarkResult.EnumerationDuration.TotalMilliseconds, StringFormat={}{0:N0} ms}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Caption}" Text="Metadados" />
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                                               Text="{Binding BenchmarkResult.MetadataReadDuration.TotalMilliseconds, StringFormat={}{0:N0} ms}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Caption}" Text="Itens na pasta" />
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold">
                                        <Run Text="{Binding BenchmarkResult.FileCount, Mode=OneWay}" /> <Run Text="arquivos" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{StaticResource Caption}" Text="Tamanho total" />
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                                               Text="{Binding BenchmarkResult.TotalSizeBytes, Converter={StaticResource ScoreToValue}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Gargalos detectados -->
                            <StackPanel Visibility="{Binding BenchmarkResult.IdentifiedBottlenecks.Count, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Gargalos identificados" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding BenchmarkResult.IdentifiedBottlenecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="⚠" Foreground="{DynamicResource MediumBrush}" FontWeight="Bold" Margin="0,0,8,0" />
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Lista de Shell Extensions (Seção 16 do PROMPT) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" Text="Extensões de Shell Instaladas" Margin="0" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding SummaryText}" />
                    </DockPanel>

                    <!-- Filtros e Busca -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Pesquisar por extensão, DLL ou fabricante..." />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Content="Todas" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Todas}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Problemas" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Problemas}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Menu de Contexto" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Menu de Contexto}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Miniaturas e Visualização" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Miniaturas e Visualização}"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Ícones" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Ícones}"
                                         VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Tabela de Extensões -->
                    <ListView ItemsSource="{Binding FilteredExtensions}" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nome da Extensão" Width="260">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShellExtensionRowViewModel}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource CriticalBrush}"
                                                         Visibility="{Binding IsOrphan, Converter={StaticResource VisibleWhen}}" />
                                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Tipo" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShellExtensionRowViewModel}">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding TypeText}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Fabricante" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShellExtensionRowViewModel}">
                                            <TextBlock Style="{StaticResource Body}" Text="{Binding Publisher}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Assinatura" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShellExtensionRowViewModel}">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SignedText}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Arquivo DLL" Width="240">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShellExtensionRowViewModel}">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DllFileName}" ToolTip="{Binding DllPath}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Status" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShellExtensionRowViewModel}">
                                            <TextBlock Style="{StaticResource Body}" FontSize="12" FontWeight="SemiBold"
                                                       Text="{Binding StatusText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

