<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             xmlns:appSec="clr-namespace:LeccorWindowsHealthCenter.Application.Security;assembly=LeccorWindowsHealthCenter.Application"
             xmlns:appCrash="clr-namespace:LeccorWindowsHealthCenter.Application.Crash;assembly=LeccorWindowsHealthCenter.Application"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:SecurityViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Auditar Segurança"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Segurança &amp; Crash Analyzer" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Status do Windows Security/Defender, Firewall, UAC, persistências suspeitas e análise de travamentos (Crash Analyzer)." />
                </StackPanel>
            </DockPanel>

            <!-- Card de Aviso Legal / Princípio de Segurança (Seção 30) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource CardAltBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Princípio da Seção 30 do PROMPT" />
                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                   Text="O Leccor Health Center não tenta substituir o antivírus. Utilizamos os dados oficiais do Windows Security/Defender e auditamos persistências no sistema sem declarar falsos positivos." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Cards de Status de Segurança -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <!-- Card Antivírus -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="ANTIVÍRUS ATIVO" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Security.AntivirusProducts.Count, FallbackValue='0'}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Solução de proteção em tempo real" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card UAC -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="CONTROLE DE CONTA (UAC)" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Security.IsUacEnabled, Converter={StaticResource BoolToStatusConverter}, FallbackValue='Ativo'}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Proteção contra elevação oculta" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card BSODs (Últimos 30 dias) -->
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="TRAVAMENTOS (BSOD - 30 DIAS)" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Crash.TotalBsodEventsPast30Days, FallbackValue='0'}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Eventos críticos de BugCheck" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Produtos de Proteção Registrados -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Soluções de Proteção Registradas no Windows" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding AntivirusProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appSec:AntivirusProductInfo}">
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold"
                                                       Text="{Binding IsEnabled, Converter={StaticResource BoolToStatusConverter}}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PathToSignedProductExe}" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Crash Analyzer: Top Falhas de Aplicativos e Dumps -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Crash Analyzer — Travamentos e Despejos de Memória" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Caption}" Text="Arquivos de despejo (.dmp) detectados no disco e aplicativos com falhas frequentes:" Margin="0,0,0,8" Foreground="{DynamicResource TextMutedBrush}" />

                    <ItemsControl ItemsSource="{Binding RecentDumps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appCrash:DumpFileInfo}">
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding DumpType}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding FileName}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding FilePath}" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Text="Nenhum arquivo de despejo de travamento encontrado."
                               Visibility="{Binding RecentDumps.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
