<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             xmlns:controls="clr-namespace:LeccorWindowsHealthCenter.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}">
    <UserControl.Resources>
        <!-- Um finding responde: o que aconteceu, como sabemos, impacto, como corrigir, risco e se pode desfazer. -->
        <DataTemplate x:Key="FindingTemplate" DataType="{x:Type vm:FindingItemViewModel}">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                <Expander Padding="16,4,16,16">
                    <Expander.Header>
                        <DockPanel Margin="4,8">
                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource SeverityDot}" Tag="{Binding Severity}" Margin="0,0,12,0" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding ConfidenceText}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SemanticText}" Tag="{Binding Severity}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding SeverityText}" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel Margin="26,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="O que aconteceu?" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding WhatHappened}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Como sabemos disso?" />
                        <ItemsControl ItemsSource="{Binding Evidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EvidenceLine}">
                                    <StackPanel Margin="0,1">
                                        <TextBlock Style="{StaticResource Body}">
                                            <Run Text="•" /> <Run Text="{Binding Text, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" Margin="12,0,0,0" Text="{Binding Technical}"
                                                   Visibility="{Binding DataContext.Preferences.AdvancedMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding ProbableCause, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Causa provável" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding ProbableCause}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Qual o impacto?" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Impact}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Como corrigir?" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Recommendation}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Risco da correção" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding RiskText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Posso desfazer?" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding RollbackText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Requisitos" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding Requirements}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <TextBlock Style="{StaticResource PageTitle}" Text="Varredura" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"
                       Text="A varredura apenas mede e analisa. Nenhuma alteração é feita no computador durante a varredura." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{StaticResource MediumBrush}"
                    Visibility="{Binding NoScannersInstalled, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Body}"
                           Text="Esta versão contém a infraestrutura de diagnóstico (orquestrador, regras, risco, score, histórico e logs), mas ainda nenhum scanner. Os scanners do MVP 1 serão adicionados no próximo passo. Uma varredura agora termina sem dados — e por isso sem score." />
            </Border>

            <!-- Modos -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <!-- Botão ancorado no rodapé: a UniformGrid iguala as alturas e os três botões ficam alinhados. -->
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Iniciar rápida" Command="{Binding QuickScanCommand}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Varredura rápida" />
                        <TextBlock Style="{StaticResource Caption}" Text="1–3 minutos. CPU, RAM, disco, processos, espaço, Explorer, startup, serviços com erro, eventos recentes e Windows Update." />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Executar varredura completa" Command="{Binding FullScanCommand}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Varredura completa" />
                        <TextBlock Style="{StaticResource Caption}" Text="Executa todos os módulos de diagnóstico disponíveis." />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Executar selecionados" Command="{Binding CustomScanCommand}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Personalizada" />
                        <TextBlock Style="{StaticResource Caption}" Text="Escolha os módulos abaixo e execute somente o que precisa." />
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Expander Header="Módulos da varredura personalizada" Margin="0,0,0,16" FontSize="14">
                <ItemsControl ItemsSource="{Binding Modules}" Margin="24,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModuleOption}">
                            <CheckBox Width="170" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- Progresso -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Cancelar varredura" Command="{Binding CancelCommand}" />
                        <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0">
                            <Run Text="{Binding ScanTitle, Mode=OneWay}" /> <Run Text="—" /> <Run Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0}%}" />
                        </TextBlock>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,14,0,12" Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{Binding Scanners}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScannerStateItem}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Style="{StaticResource SemanticText}" Tag="{Binding Status}" Width="26" FontSize="14"
                                               FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Text="{Binding Glyph}"
                                               AutomationProperties.Name="{Binding StatusText}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Resultado -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="110" Height="110" Margin="0,0,24,0">
                            <controls:RingGauge Style="{StaticResource ScoreRing}" Tag="{Binding Rating}" Thickness="9"
                                                Value="{Binding ScoreText, Converter={StaticResource ScoreToValue}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ScoreText}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ResultTitle}" Margin="0" />
                            <TextBlock Style="{StaticResource SemanticText}" Tag="{Binding Rating}" FontSize="20" FontWeight="Bold" Margin="0,4"
                                       Text="{Binding RatingText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CountsText}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding CoverageText}"
                                       Visibility="{Binding CoverageText, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{Binding ResultNote}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Visibility="{Binding ScannerErrors, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Módulos que não puderam ser analisados" />
                    <ItemsControl ItemsSource="{Binding ScannerErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding Problems, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Problemas" />
                    <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource FindingTemplate}" />
                </StackPanel>

                <StackPanel Visibility="{Binding Recommendations, Converter={StaticResource VisibleWhen}}" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Recomendações" />
                    <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource FindingTemplate}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
