<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.DevToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             xmlns:appDev="clr-namespace:LeccorWindowsHealthCenter.Application.DevTools;assembly=LeccorWindowsHealthCenter.Application"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:DevToolsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Atualizar"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Desenvolvimento &amp; DevTools" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Diagnóstico de Docker Desktop, distribuições WSL2, runtimes instalados e integridade do PATH." />
                </StackPanel>
            </DockPanel>

            <!-- Card de Ocupado -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Grid de Docker e WSL -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- Docker Desktop Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="🐳" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Docker Desktop / Engine" VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource Caption}" Text="Status:" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" FontWeight="SemiBold"
                                       Text="{Binding Docker.IsRunning, Converter={StaticResource BoolToStatusConverter}, FallbackValue='Parado'}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource Caption}" Text="Backend de Execução:" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" Text="{Binding Docker.Backend, FallbackValue='—'}" />
                        </DockPanel>

                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}">
                                <Run FontWeight="Bold" Text="Aviso de Segurança (Seção 32):" />
                                <Run Text="Volumes Docker podem conter dados permanentes e bancos de dados. Nunca executamos 'docker prune' automaticamente." />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Hyper-V e PATH Card -->
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="⚙️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Recursos de Virtualização &amp; PATH" VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource Caption}" Text="Serviço Hyper-V (vmms):" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" FontWeight="SemiBold"
                                       Text="{Binding HasHyperV, Converter={StaticResource BoolToStatusConverter}, FallbackValue='Inativo'}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource Caption}" Text="Tamanho da variável PATH:" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" Text="{Binding PathAnalysis.TotalLength, StringFormat='{}{0} caracteres'}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource Caption}" Text="Pastas inexistentes no PATH:" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding PathAnalysis.InvalidEntries.Count, FallbackValue='0'}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Card de Distribuições WSL -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Distribuições WSL (Windows Subsystem for Linux)" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding WslDistributions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appDev:WslDistributionInfo}">
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="{Binding WslVersion, StringFormat='WSL {0}'}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding VhdxPath}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Text="Nenhuma distribuição WSL configurada encontrada."
                               Visibility="{Binding WslDistributions.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8" />
                </StackPanel>
            </Border>

            <!-- Card de Runtimes e Ferramentas Instaladas -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Runtimes, Compiladores &amp; IDEs Detectados" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type appDev:DevToolItem}">
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2"
                                                Background="{DynamicResource CardBrush}">
                                            <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="{Binding Version}" />
                                        </Border>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Category}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusDetail}" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
