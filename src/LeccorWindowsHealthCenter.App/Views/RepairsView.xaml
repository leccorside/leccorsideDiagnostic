<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.RepairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:RepairsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Ponto de Restauração"
                            Command="{Binding CreateRestorePointCommand}" Margin="0,0,8,0"
                            ToolTip="Cria um ponto de restauração nativo do Windows antes de fazer alterações." />
                    <Button Style="{StaticResource SecondaryButton}" Content="Simular (Dry Run)"
                            Command="{Binding RunDryRunCommand}" Margin="0,0,8,0"
                            ToolTip="Calcula exatamente o que seria alterado sem modificar nada no sistema." />
                    <Button Style="{StaticResource PrimaryButton}" Content="Aplicar Selecionadas"
                            Command="{Binding ApplySelectedRepairsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Atualizar"
                            Command="{Binding RefreshDataCommand}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Central de Correções" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Correções reais, simulação (Dry Run), backup prévio obrigatório e restauração reversível (Rollback)." />
                </StackPanel>
            </DockPanel>

            <!-- Card de Garantia de Segurança e Backup Prévio -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource CardAltBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock Text="🛡️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Princípio de Segurança Leccor (Seções 35–39 do PROMPT)" />
                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                   Text="Nenhuma alteração é efetuada sem que o estado anterior esteja gravado em backup seguro no disco. Correções reversíveis podem ser desfeitas a qualquer momento pelo botão Desfazer no Histórico." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card de Feedback de Operação (Feedback) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource CardAltBrush}"
                    Visibility="{Binding OperationFeedback, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Resultado da Operação:" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding OperationFeedback}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Indicador de Ocupado -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Seletor de Abas -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,16" Background="Transparent" BorderThickness="0">
                <!-- Aba 1: Correções Disponíveis -->
                <TabItem Header="Correções Disponíveis" Padding="14,8" FontWeight="SemiBold">
                    <StackPanel Margin="0,16,0,0">
                        <!-- Barra de seleção rápida -->
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Marcar Todas"
                                        Command="{Binding SelectAllCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Desmarcar Todas" Margin="8,0,0,0"
                                        Command="{Binding DeselectAllCommand}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center">
                                <Run Text="Itens selecionados para aplicação:" />
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="de" />
                                <Run Text="{Binding AvailableRepairs.Count, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>

                        <!-- Lista de Correções -->
                        <ItemsControl ItemsSource="{Binding AvailableRepairs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AvailableRepairItemViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="6,2" Margin="4,0,0,0"
                                                                Visibility="{Binding RequiresElevation, Converter={StaticResource VisibleWhen}}">
                                                            <TextBlock Style="{StaticResource Caption}" Text="Exige Admin" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="6,2" Margin="4,0,0,0"
                                                                Visibility="{Binding SupportsRollback, Converter={StaticResource VisibleWhen}}">
                                                            <TextBlock Style="{StaticResource Caption}" Text="Rollback Total" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="6,2" Margin="4,0,0,0"
                                                                Visibility="{Binding IsMeasurable, Converter={StaticResource VisibleWhen}}">
                                                            <TextBlock Style="{StaticResource Caption}" Text="Antes/Depois" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding RiskBadge}" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding Title}" />
                                                </DockPanel>

                                                <TextBlock Style="{StaticResource Body}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding MeasurementInfo}" Foreground="{DynamicResource TextMutedBrush}" />

                                                <Border Margin="0,8,0,0" Padding="8" Background="{DynamicResource CardAltBrush}" CornerRadius="4"
                                                        Visibility="{Binding DryRunResult, Converter={StaticResource VisibleWhen}}">
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DryRunResult}" FontFamily="Consolas" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <!-- Aba 2: Histórico de Correções & Rollback -->
                <TabItem Header="Histórico de Correções &amp; Rollback" Padding="14,8" FontWeight="SemiBold">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="Todas as ações de reparo aplicadas, backups associados e suporte a reversão (Rollback):" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding HistoryRecords}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RepairHistoryItemViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <DockPanel>
                                            <!-- Botão Rollback à Direita -->
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Desfazer"
                                                    Command="{Binding DataContext.RollbackRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanRollback}"
                                                    VerticalAlignment="Center" Margin="16,0,0,0"
                                                    ToolTip="Restaura o estado do sistema salvo no backup anterior a esta correção." />

                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding DateText}" Margin="12,0,0,0" />
                                                    <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding ActionTitle}" />
                                                </DockPanel>

                                                <DockPanel Margin="0,2,0,4">
                                                    <Border Background="{DynamicResource CardAltBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,8,0">
                                                        <TextBlock Style="{StaticResource Caption}" FontWeight="Bold" Text="{Binding OutcomeText}" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ReasonText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Style="{StaticResource Body}" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,4" />

                                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ComparisonText}"
                                                           Foreground="{DynamicResource OkBrush}"
                                                           Visibility="{Binding ComparisonText, Converter={StaticResource VisibleWhen}}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mensagem quando vazio -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HistoryRecords.Count, Converter={StaticResource VisibleWhenZero}}" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Body}" Text="Nenhuma correção registrada no histórico ainda. Execute uma correção para acompanhar seu estado e opções de Rollback."
                                       HorizontalAlignment="Center" Margin="0,16" Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
