<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             d:DataContext="{d:DesignInstance Type=vm:HardwareViewModel}">
    <UserControl.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Ler novamente" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource PageTitle}" Text="Hardware" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" Text="{Binding CapturedText}" />

            <!-- Carregando -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Body}" Text="Lendo o inventário de hardware (WMI e registro do Windows)…" />
            </Border>

            <!-- Erro -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource CriticalBrush}" Margin="0,0,0,12"
                    Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Error}" />
            </Border>

            <!-- Inventário vazio: o Windows respondeu sem dados (não é "este computador não tem hardware"). -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource MediumBrush}" Margin="0,0,0,12"
                    Visibility="{Binding InventoryEmpty, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="O Windows não devolveu dados de inventário" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="A consulta ao WMI terminou sem erro, mas sem nenhum dado de sistema, processador, memória ou vídeo. Isso costuma ser temporário (serviço WMI reiniciando ou ocupado). Use “Ler novamente”; se persistir, ative o modo avançado nas Configurações para ver quais fontes não responderam." />
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding HasInventory, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource GroupTitle}" Margin="0,0,0,8" Text="Sistema" Visibility="{Binding System, Converter={StaticResource VisibleWhen}}" />
                    <ContentControl Content="{Binding System}" ContentTemplate="{StaticResource InfoCardTemplate}" Focusable="False" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Processador" Visibility="{Binding Processors, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Processors}" ItemTemplate="{StaticResource InfoCardTemplate}" Focusable="False" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource GroupTitle}" Margin="0,0,0,8" Text="Memória" Visibility="{Binding Memory, Converter={StaticResource VisibleWhen}}" />
                    <!-- Resumo + módulos como linhas compactas no mesmo cartão: 24 pentes não viram uma torre de cartões. -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Memory, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0" TextWrapping="Wrap" Text="{Binding Memory.Title}" />
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Memory.Rows}" ItemTemplate="{StaticResource InfoRowTemplate}" Focusable="False" />
                            <Border Margin="0,12,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                                    Visibility="{Binding MemoryModules, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding MemoryModules}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MemoryModuleRow}">
                                            <StackPanel Margin="0,6">
                                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Heading}" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0" Text="{Binding Detail}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Placa de vídeo" Visibility="{Binding Gpus, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Gpus}" ItemTemplate="{StaticResource InfoCardTemplate}" Focusable="False" />
                </StackPanel>
            </Grid>

            <!-- Fontes que falharam: técnico, só no modo avançado -->
            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding AdvancedModeWithWarnings, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Fontes que não responderam" />
                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
