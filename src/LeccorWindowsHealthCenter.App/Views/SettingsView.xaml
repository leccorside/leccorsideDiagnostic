<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="Configurações" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,20" Text="Tudo funciona localmente. Nenhum dado é enviado para servidores externos." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Aparência" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Theme" Content="Seguir o Windows"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        <RadioButton GroupName="Theme" Content="Claro"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                        <RadioButton GroupName="Theme" Content="Escuro"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Modo avançado" />
                    <CheckBox Content="Exibir detalhes técnicos (Event IDs, caminhos de registro, comandos, exit codes, métricas)"
                              IsChecked="{Binding Preferences.AdvancedMode}" />
                    <CheckBox Content="Verificar revogação online de certificados digitais (CRL/OCSP)"
                              IsChecked="{Binding CheckRevocationOnline}"
                              Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Margin="24,2,0,0"
                               Text="Consulta listas de revogação na rede (CRL/OCSP) para validar se certificados de terceiros foram cancelados." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Agendamento de Varreduras" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" Text="Execução periódica de diagnóstico em segundo plano via Windows Task Scheduler (seção 60)." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Frequência" />
                    <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedValue="{Binding SelectedFrequency}" SelectedValuePath="Frequency" DisplayMemberPath="Label" Height="36" VerticalContentAlignment="Center" Margin="0,4,0,12" />

                    <TextBlock Style="{StaticResource Body}" Text="{Binding ScheduleStatusText}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ScheduleNextRunText}" Visibility="{Binding ScheduleNextRunText, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12" />

                    <WrapPanel>
                        <Button Command="{Binding SaveScheduleCommand}" Style="{StaticResource PrimaryButton}" Content="Salvar Agendamento" IsEnabled="{Binding IsSavingSchedule, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" Margin="0,0,12,0" Padding="16,8" />
                        <Button Command="{Binding RefreshScheduleStatusCommand}" Content=" Atualizar Status" Padding="12,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Segurança" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding PrivilegeText}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Modo simulação (Dry Run)" />
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="{Binding DryRunText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" — configurado em appsettings.json (Repair:DryRun). Em simulação, nenhuma correção altera o sistema." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Dados locais" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta de dados" />
                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Paths.Root, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Logs" />
                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Paths.Logs, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Backups" />
                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Paths.Backups, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Banco de dados (SQLite)" />
                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Paths.Database, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" ClipToBounds="True" Width="96" Height="96" Margin="0,0,20,0">
                        <Image Source="{DynamicResource LogoImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Leccor Windows Health Center" Margin="0" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Version, StringFormat=Versão {0}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Diagnóstico técnico + transparência + segurança." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
