<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel}">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButton}" Content="Abrir services.msc"
                        Command="{Binding OpenServicesMscCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Atualizar"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Serviços" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Inventário de serviços do Windows, detecção de falhas e identificação de executáveis órfãos." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding SummaryText}" />
            </StackPanel>
        </DockPanel>

        <!-- Barra de Busca e Filtros -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Pesquisar por nome, executável ou fabricante..." />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton Content="Todos" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Todos}"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
                <RadioButton Content="Com Falha / Órfãos" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Com Falha / Órfãos}"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
                <RadioButton Content="Automáticos" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Automáticos}"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
                <RadioButton Content="Em Execução" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Em Execução}"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
                <RadioButton Content="Terceiros" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Terceiros}"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Master-Detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="350" />
                <ColumnDefinition Width="4*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Tabela de Serviços -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <ListView ItemsSource="{Binding FilteredServices}" SelectedItem="{Binding SelectedService}"
                          BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nome de Exibição" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServiceRowViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource CriticalBrush}"
                                                     Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}" />
                                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Nome do Serviço" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServiceRowViewModel}">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ServiceName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Status" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServiceRowViewModel}">
                                        <TextBlock Style="{StaticResource Body}" FontSize="12" Text="{Binding StateText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Inicialização" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServiceRowViewModel}">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StartupTypeText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Painel de Detalhes -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedService}">
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="16" Text="{Binding DisplayName}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ServiceName}" Margin="0,0,0,12" />

                        <!-- Alerta se órfão -->
                        <Border Background="{DynamicResource CriticalBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,12"
                                Visibility="{Binding IsOrphan, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       Text="Aviso: O arquivo executável deste serviço não foi encontrado no disco." TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Descrição" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Status atual" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding StateText}" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Tipo de inicialização" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding StartupTypeText}" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Caminho do executável" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ExecutablePath}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Fabricante e Assinatura" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10">
                            <Run Text="{Binding Publisher, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding SignedText, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Conta de logon" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding AccountText}" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Dependências" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DependenciesText}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

