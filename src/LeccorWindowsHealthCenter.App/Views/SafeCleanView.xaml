<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.SafeCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:SafeCleanViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Analisar Locais"
                        Command="{Binding AnalyzeCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Limpeza Segura (Safe Cleaner)" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Análise profunda e categorização de arquivos temporários, caches e itens residuais por nível de risco." />
                </StackPanel>
            </DockPanel>

            <!-- Card de Aviso: Somente Visualização -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource CardAltBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,0,20">
                <DockPanel>
                    <TextBlock Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="Auditoria Somente Leitura (Passo 7)" />
                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                   Text="Nenhum arquivo pessoal ou do sistema é apagado nesta fase. O motor de exclusão segura, aprovação explícita e rollback automático com ponto de restauração serão ativados no Passo 8 (MVP 3)." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Cards de Totais por Categoria -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="SEGURO (SAFE)" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding SafeCleanableText}" Margin="0,4,0,0" Foreground="{DynamicResource OkBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Descarte sem impacto" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="REVISAR (REVIEW)" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding ReviewCleanableText}" Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Caches e downloads" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="AVANÇADO (ADVANCED)" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding AdvancedCleanableText}" Margin="0,4,0,0" Foreground="{DynamicResource CriticalBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="WinSxS e despejos" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="TOTAL IDENTIFICADO" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TotalCleanableText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TotalFilesCount, StringFormat={}{0:N0} arquivos analisados}" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Seletor de Categoria (Tabs) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Categoria:" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox ItemsSource="{Binding CategoryTabs}"
                              SelectedItem="{Binding SelectedCategoryTab}"
                              Width="180" Height="34" VerticalContentAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Lista de Itens da Categoria Selecionada -->
            <ItemsControl ItemsSource="{Binding CurrentCategoryItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CleanItemRowViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding Title}" Margin="0,0,8,0" />
                                        <Border CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CategoryText}" Value="Seguro">
                                                            <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CategoryText}" Value="Revisar">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CategoryText}" Value="Avançado">
                                                            <Setter Property="Background" Value="{DynamicResource CriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CategoryText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" Margin="0,4,0,8" />

                                    <TextBlock Style="{StaticResource Caption}" Text="JUSTIFICATIVA TÉCNICA:" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding TechnicalJustification}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" />

                                    <TextBlock Style="{StaticResource Caption}" Text="CAMINHOS ALVO:" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding PathsText}" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource Subheading}" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding FileCountText}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

