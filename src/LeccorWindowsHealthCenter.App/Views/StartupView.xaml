<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             xmlns:controls="clr-namespace:LeccorWindowsHealthCenter.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="1400"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}">
    <!-- F5 lê de novo; Ctrl+C na linha copia o caminho (code-behind). -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,24,0,2" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>

        <!-- O menu não está na árvore visual: o ViewModel chega pelo Tag da linha (PlacementTarget.Tag). -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Mostrar no Explorer"
                      Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding Path}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE838;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar caminho" InputGestureText="Ctrl+C"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding Path}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8C8;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar linha de comando"
                      Command="{Binding PlacementTarget.Tag.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding Command}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE756;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Linha: nome e fabricante à esquerda; origem e estado no meio; impacto à direita. Clique mostra no Explorer. -->
        <DataTemplate x:Key="StartupRowTemplate" DataType="{x:Type vm:StartupRow}">
            <Button x:Name="RowButton" Style="{StaticResource RowButton}" ToolTip="{Binding Command}" ContextMenu="{StaticResource RowMenu}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}"
                    AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Command}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="180" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" MinWidth="140" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Impact" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="NameText" Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding Name}" />
                        <TextBlock x:Name="PublisherText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="{Binding Publisher}" ToolTip="{Binding SignatureText}"
                                   Visibility="{Binding Publisher, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock x:Name="ProblemText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MediumBrush}" Text="{Binding Problem}"
                                   Visibility="{Binding Problem, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding StatusText}" />
                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding SourceText}"
                                   ToolTip="{Binding SourceText}" />
                    </StackPanel>
                    <TextBlock x:Name="ImpactText" Grid.Column="4" Style="{StaticResource Body}" VerticalAlignment="Top" TextAlignment="Right"
                               Text="{Binding ImpactText}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <!-- Desativado: tinta secundária, ainda legível. Alto impacto em semibold (fato medido, não alarme). -->
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighImpact}" Value="True">
                    <Setter TargetName="ImpactText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMeasured}" Value="False">
                    <Setter TargetName="ImpactText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInformational}" Value="True">
                    <Setter TargetName="ProblemText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter TargetName="ProblemText" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SignatureInvalid}" Value="True">
                    <Setter TargetName="PublisherText" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="PublisherText" Property="Text" Value="assinatura inválida" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path}" Value="{x:Null}">
                    <Setter TargetName="RowButton" Property="Command" Value="{x:Null}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Ler novamente" ToolTip="Lê de novo registro, pastas Inicializar, tarefas e serviços (F5).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Ler novamente" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource PageTitle}" Text="Inicialização" AutomationProperties.HeadingLevel="Level1" />
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding CapturedText}" />

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Body}" Text="Lendo registro, pastas Inicializar, tarefas agendadas e serviços…" />
            </Border>
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource CriticalBrush}" Margin="0,12,0,0"
                    Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding Error}" />
            </Border>

            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" Text="{Binding Summary}"
                       Visibility="{Binding Summary, Converter={StaticResource VisibleWhen}}" />

            <!-- Laudo primeiro: entradas com problema, mesmos critérios da varredura (arquivo ausente, pasta temporária). -->
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Problems}" Focusable="False"
                          Visibility="{Binding Problems, Converter={StaticResource VisibleWhen}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                        <controls:AccessibleRegion Margin="0,0,0,12" FocusVisualStyle="{StaticResource CardFocusRing}"
                                                   AutomationProperties.Name="{Binding AccessibleName}">
                            <Border x:Name="ProblemCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource MediumBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProblemIcon" Style="{StaticResource Icon}" FontSize="20" Margin="0,1,14,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource MediumBrush}" Text="&#xE7BA;" AutomationProperties.Name="Atenção" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0" TextWrapping="Wrap" Text="{Binding Name}"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Problem}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding Command}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding SourceText}" />
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="{Binding Advice}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="16,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Command}" AutomationProperties.Name="Copiar comando">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Copiar comando" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </controls:AccessibleRegion>
                        <DataTemplate.Triggers>
                            <!-- Componente do Windows: a regra emite Info; cor de alerta só com achado que pede ação. -->
                            <DataTrigger Binding="{Binding IsInformational}" Value="True">
                                <Setter TargetName="ProblemCard" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Setter TargetName="ProblemIcon" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter TargetName="ProblemIcon" Property="Text" Value="&#xE946;" />
                                <Setter TargetName="ProblemIcon" Property="AutomationProperties.Name" Value="Informação" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Filtros. -->
            <WrapPanel Margin="0,16,0,0">
                <TextBox Style="{StaticResource FilterBox}" Width="320" Margin="0,0,20,8"
                         Tag="Pesquisar por nome, comando ou fabricante" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Pesquisar itens de inicialização" />
                <CheckBox VerticalAlignment="Center" Margin="0,0,20,8" Content="Mostrar desativados" IsChecked="{Binding ShowDisabled}" />
                <CheckBox VerticalAlignment="Center" Margin="0,0,20,8" Content="Mostrar itens do próprio Windows" IsChecked="{Binding ShowWindowsItems}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Impacto estimado pelo consumo atual dos processos com o mesmo executável (memória privada e tempo de CPU desde que iniciaram). Itens que não estão rodando agora aparecem como “não medido”." />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding HiddenText}"
                       Visibility="{Binding HiddenText, Converter={StaticResource VisibleWhen}}" />

            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupGroup}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupTitle}">
                                <Run Text="{Binding Title, Mode=OneWay}" /><Run Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" Text="{Binding Rows.Count, Mode=OneWay, StringFormat='  {0}'}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding Caption}" />
                            <Border Style="{StaticResource Card}" Padding="8">
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource StartupRowTemplate}" Focusable="False" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Body}" Margin="0,16,0,0" Text="Nenhum item corresponde à pesquisa."
                       Visibility="{Binding NoResults, Converter={StaticResource VisibleWhen}}" />

            <TextBlock Style="{StaticResource Body}" Margin="0,16,0,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"
                       Text="{Binding ActionMessage}" Visibility="{Binding ActionMessage, Converter={StaticResource VisibleWhen}}" />

            <StackPanel Margin="0,16,0,0" Visibility="{Binding AdvancedModeWithWarnings, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Fontes que não responderam" />
                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
