<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             d:DataContext="{d:DesignInstance Type=vm:WindowsUpdateViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource PrimaryButton}" Content="Abrir Windows Update"
                            Command="{Binding OpenWindowsUpdateSettingsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Atualizar"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Windows Update" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Status de serviços de atualização, verificação de reinicializações pendentes e histórico de pacotes instalados." />
                </StackPanel>
            </DockPanel>

            <!-- Card Destaque: Reinicialização Pendente -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="1.5"
                    Margin="0,0,0,20" Visibility="{Binding IsRebootPending, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border Background="{DynamicResource CriticalBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Text="REINICIALIZAÇÃO NECESSÁRIA" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="Ação Recomendada" Foreground="{DynamicResource CriticalBrush}" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding RebootReason}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                               Text="Reinicie o computador para concluir a aplicação das atualizações e liberar arquivos temporários do instalador." />
                </StackPanel>
            </Border>

            <!-- Resumo e Serviços -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="ÚLTIMA BUSCA" />
                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding LastScanText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Verificação de updates" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="ÚLTIMA INSTALAÇÃO" />
                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding LastInstallText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Pacote aplicado com sucesso" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="SERVIÇO WUAUSERV" />
                        <TextBlock Style="{StaticResource Body}" FontWeight="Bold" Text="{Binding WuauservState}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Windows Update Service" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="SERVIÇOS DE SUPORTE" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                            <Run Text="BITS: " FontWeight="SemiBold" /><Run Text="{Binding BitsState, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                            <Run Text="DoSvc: " FontWeight="SemiBold" /><Run Text="{Binding DosvcState, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Histórico de Atualizações Instaladas -->
            <TextBlock Style="{StaticResource Subheading}" Text="Histórico de Atualizações Recentes" Margin="0,0,0,12" />

            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UpdateHistoryRowViewModel}">
                            <Border Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <DockPanel>
                                            <Border Background="{DynamicResource CardAltBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding HotFixId}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Description}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding InstalledBy}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding InstalledOnText}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

