<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             xmlns:controls="clr-namespace:LeccorWindowsHealthCenter.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1200">
            <TextBlock Style="{StaticResource PageTitle}" Text="Saúde do computador" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Diagnóstico técnico, transparente e seguro. Cada problema mostra evidência, impacto, risco e se pode ser desfeito." Margin="0,0,0,20" />

            <!-- Boas-vindas (antes da primeira varredura) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding HasScanResult, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" ClipToBounds="True" Width="132" Height="132" Margin="0,0,24,0">
                        <Image Source="{DynamicResource LogoImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="20" Text="Bem-vindo ao Leccor Windows Health Center" />
                        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Execute uma varredura para medir o estado real deste computador. Nada é alterado sem a sua aprovação, e toda correção tem backup e, quando possível, pode ser desfeita." />
                        <TextBlock Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   Text="MEDIR → DETECTAR → COMPROVAR → EXPLICAR → CORRIGIR → VALIDAR → DESFAZER" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!-- Score -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="140" Height="140" Margin="0,0,24,0">
                            <controls:RingGauge Value="{Binding ScoreText, Converter={StaticResource ScoreToValue}}" Thickness="12"
                                                Stroke="{Binding Rating, Converter={StaticResource SemanticBrush}}"
                                                Track="{DynamicResource TrackBrush}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ScoreText}" />
                                <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="/ 100" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Saúde do computador" />
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,2,0,6"
                                       Foreground="{Binding Rating, Converter={StaticResource SemanticBrush}}" Text="{Binding RatingText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding ScoreSubtitle}" Margin="0,0,0,16" />
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartFullScanCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Executar varredura completa" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding StartQuickScanCommand}" Content="Varredura rápida" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Resumo dos problemas -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Resultado da última varredura" />
                        <TextBlock Style="{StaticResource Caption}" Text="Execute uma varredura para ver problemas confirmados e recomendações."
                                   Visibility="{Binding HasScanResult, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                        <StackPanel Visibility="{Binding HasScanResult, Converter={StaticResource VisibleWhen}}">
                            <StackPanel.Resources>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Width" Value="10" />
                                    <Setter Property="Height" Value="10" />
                                    <Setter Property="Margin" Value="0,0,10,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Fill="{StaticResource CriticalBrush}" />
                                <TextBlock Style="{StaticResource Body}"><Run Text="{Binding CriticalCount, Mode=OneWay}" FontWeight="SemiBold" /> problema(s) crítico(s)</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Fill="{StaticResource HighBrush}" />
                                <TextBlock Style="{StaticResource Body}"><Run Text="{Binding ImportantCount, Mode=OneWay}" FontWeight="SemiBold" /> problema(s) importante(s)</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Fill="{StaticResource LowBrush}" />
                                <TextBlock Style="{StaticResource Body}"><Run Text="{Binding MinorCount, Mode=OneWay}" FontWeight="SemiBold" /> problema(s) menor(es)</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Fill="{StaticResource MediumBrush}" />
                                <TextBlock Style="{StaticResource Body}"><Run Text="{Binding RecommendationCount, Mode=OneWay}" FontWeight="SemiBold" /> recomendação(ões)</TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding FindingsSummary}" />

                            <Border Margin="0,14,0,0" Padding="14" CornerRadius="6" Background="{DynamicResource CardAltBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding TopProblem, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="Problema mais importante" />
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,2" Text="{Binding TopProblem.Title}"
                                               Foreground="{Binding TopProblem.Severity, Converter={StaticResource SemanticBrush}}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding TopProblem.WhatHappened}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Recomendação" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding TopProblem.Recommendation}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Uso atual -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Uso atual" Margin="0,8,0,8" />
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding CpuText}" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Text="CPU" VerticalAlignment="Center" />
                        </DockPanel>
                        <controls:Sparkline Height="48" Margin="0,12,0,0" Values="{Binding CpuHistoryValues}"
                                            Stroke="{DynamicResource ChartStrokeBrush}" Fill="{DynamicResource ChartFillBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Últimos 2 minutos" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding RamText}" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Text="RAM" VerticalAlignment="Center" />
                        </DockPanel>
                        <controls:Sparkline Height="48" Margin="0,12,0,0" Values="{Binding RamHistoryValues}"
                                            Stroke="{DynamicResource ChartStroke2Brush}" Fill="{DynamicResource ChartFill2Brush}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding RamDetail}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DiskText}" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DiskLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,33,0,0" Value="{Binding DiskPercent, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" Text="Espaço utilizado" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding GpuText}" VerticalAlignment="Center" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Text="GPU" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0"
                                   Text="A utilização de GPU será exibida quando o scanner de GPU (MVP 1) fornecer uma medição confiável. Não exibimos valores estimados." />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
