<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}">
    <!-- Esc cancela a confirmação de encerramento; Ctrl+C e Delete na lista: ver code-behind. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelEndCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Larguras fixas compartilhadas entre cabeçalho e linhas (a lista é virtualizada: SharedSizeGroup oscilaria). -->
        <GridLength x:Key="PidWidth">64</GridLength>
        <GridLength x:Key="CpuWidth">64</GridLength>
        <GridLength x:Key="MemWidth">88</GridLength>
        <GridLength x:Key="IoWidth">88</GridLength>
        <GridLength x:Key="ThreadsWidth">62</GridLength>
        <GridLength x:Key="HandlesWidth">70</GridLength>
        <GridLength x:Key="PublisherWidth">200</GridLength>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <ContextMenu x:Key="ProcessMenu" x:Shared="False">
            <MenuItem Header="Mostrar no Explorer"
                      Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding Path}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE838;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Propriedades do arquivo"
                      Command="{Binding PlacementTarget.Tag.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding Path}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE946;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar caminho" InputGestureText="Ctrl+C"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding Path}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8C8;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24" MaxWidth="1200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Processos" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,12" Text="{Binding Summary}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Content="Mostrar como árvore"
                      IsChecked="{Binding TreeMode}" ToolTip="Cada processo abaixo de quem o iniciou." />
            <TextBox Style="{StaticResource FilterBox}" HorizontalAlignment="Left" Width="360"
                     Tag="Pesquisar por nome, PID, caminho ou fabricante" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Pesquisar processos" />
        </DockPanel>

        <!-- Cabeçalho: clicar ordena (de novo inverte). -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0,10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="{StaticResource PidWidth}" />
                    <ColumnDefinition Width="{StaticResource CpuWidth}" />
                    <ColumnDefinition Width="{StaticResource MemWidth}" />
                    <ColumnDefinition Width="{StaticResource IoWidth}" />
                    <ColumnDefinition Width="{StaticResource ThreadsWidth}" />
                    <ColumnDefinition Width="{StaticResource HandlesWidth}" />
                    <ColumnDefinition Width="{DynamicResource PublisherWidth}" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Name}" AutomationProperties.Name="Ordenar por nome">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource HeaderText}" Text="Processo" />
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Name">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Pid}" AutomationProperties.Name="Ordenar por PID">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Pid">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HeaderText}" Text="PID" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Cpu}" AutomationProperties.Name="Ordenar por CPU">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Cpu">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HeaderText}" Text="CPU" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Memory}" AutomationProperties.Name="Ordenar por memória"
                        ToolTip="Memória privada: o que o processo reservou só para ele.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Memory">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HeaderText}" Text="Memória" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Io}" AutomationProperties.Name="Ordenar por entrada e saída"
                        ToolTip="Entrada e saída por segundo: disco, rede e dispositivos somados (o Windows não separa sem administrador).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Io">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HeaderText}" Text="E/S" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Threads}" AutomationProperties.Name="Ordenar por threads">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Threads">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HeaderText}" Text="Threads" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Handles}" AutomationProperties.Name="Ordenar por handles">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Handles">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HeaderText}" Text="Handles" />
                    </StackPanel>
                </Button>
                <Button x:Name="PublisherHeader" Grid.Column="7" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Margin="12,0,0,0" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSortColumn.Publisher}" AutomationProperties.Name="Ordenar por fabricante">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource HeaderText}" Text="Fabricante" />
                        <TextBlock Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Publisher">
                                    <Binding Path="SortColumn" />
                                    <Binding Path="SortDescending" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Lista virtualizada: centenas de linhas atualizadas a cada 2 s sem recriar elementos. -->
        <ListBox x:Name="ProcessList" Grid.Row="3" ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected}"
                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TableRow}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                 AutomationProperties.Name="Lista de processos">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProcessItem}">
                    <Grid Background="Transparent" ContextMenu="{StaticResource ProcessMenu}"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          AutomationProperties.Name="{Binding AccessibleName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="{StaticResource PidWidth}" />
                            <ColumnDefinition Width="{StaticResource CpuWidth}" />
                            <ColumnDefinition Width="{StaticResource MemWidth}" />
                            <ColumnDefinition Width="{StaticResource IoWidth}" />
                            <ColumnDefinition Width="{StaticResource ThreadsWidth}" />
                            <ColumnDefinition Width="{StaticResource HandlesWidth}" />
                            <ColumnDefinition Width="{DynamicResource PublisherWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                            <TextBlock x:Name="Shield" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="&#xEA18;" Visibility="Collapsed"
                                       ToolTip="Processo protegido do Windows: não pode ser encerrado por aqui." />
                            <TextBlock Style="{StaticResource Cell}" Margin="0" Text="{Binding Name}" ToolTip="{Binding Path}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource NumberCell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PidText}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource NumberCell}" Text="{Binding CpuText}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource NumberCell}" Text="{Binding MemoryText}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource NumberCell}" Text="{Binding IoText}" />
                        <TextBlock Grid.Column="5" Style="{StaticResource NumberCell}" Text="{Binding Threads}" />
                        <TextBlock Grid.Column="6" Style="{StaticResource NumberCell}" Text="{Binding Handles}" />
                        <TextBlock x:Name="PublisherText" Grid.Column="7" Style="{StaticResource Cell}" Margin="16,0,4,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Publisher}" ToolTip="{Binding SignatureText}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCritical}" Value="True">
                            <Setter TargetName="Shield" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Assinatura inválida é evidência concreta (arquivo alterado ou certificado não confiável). -->
                        <DataTrigger Binding="{Binding SignatureInvalid}" Value="True">
                            <Setter TargetName="PublisherText" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                            <Setter TargetName="PublisherText" Property="Text" Value="assinatura inválida" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Detalhes do processo selecionado. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}}">
            <!-- Largo: ações à direita. Compacto (code-behind): ações abaixo, para os detalhes usarem a largura toda. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2">
                        <Run Text="{Binding Selected.Name, Mode=OneWay}" /><Run Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" Text="{Binding Selected.PidText, Mode=OneWay, StringFormat='  PID {0}'}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap" Text="{Binding Selected.Description}"
                               Visibility="{Binding Selected.Description, Converter={StaticResource VisibleWhen}}" />
                    <!-- Caminho em linha inteira (é o valor mais longo); os demais em dois pares rótulo → valor. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Margin" Value="0,2,12,2" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </Grid.Resources>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Executável" />
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Selected.Path, TargetNullValue='não disponível (processo protegido)'}" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" Text="Fabricante" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Publisher}" />
                        <TextBlock Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}" Text="Assinatura" />
                        <TextBlock x:Name="Signature" Grid.Row="2" Grid.Column="1" Text="{Binding Selected.SignatureText}" />
                        <TextBlock Grid.Row="3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Usuário" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.User}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Iniciado por" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding SelectedParent}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Início" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding SelectedStart}" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Tempo de CPU" />
                        <TextBlock Grid.Row="3" Grid.Column="4">
                            <Run Text="{Binding SelectedCpuTime, Mode=OneWay}" /><Run Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Selected.Threads, Mode=OneWay, StringFormat='  ·  {0} threads'}" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ProtectionText}"
                               Visibility="{Binding ProtectionText, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock x:Name="ActionText" Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite" Text="{Binding ActionMessage}"
                               Visibility="{Binding ActionMessage, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>

                <WrapPanel x:Name="ActionsPanel" Grid.Column="2" Orientation="Vertical">
                    <Button Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,6" MinWidth="200"
                            Command="{Binding RevealCommand}" CommandParameter="{Binding Selected.Path}" AutomationProperties.Name="Abrir local do arquivo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir local do arquivo" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,6" MinWidth="200"
                            Command="{Binding ShowPropertiesCommand}" CommandParameter="{Binding Selected.Path}" AutomationProperties.Name="Propriedades">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Propriedades" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,6" MinWidth="200"
                            Command="{Binding RequestEndCommand}" AutomationProperties.Name="Finalizar processo"
                            Visibility="{Binding ConfirmingEnd, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Finalizar processo" />
                        </StackPanel>
                    </Button>
                    <!-- Confirmação no lugar (sem diálogo modal): diz o custo antes de encerrar. -->
                    <Border Visibility="{Binding ConfirmingEnd, Converter={StaticResource VisibleWhen}}" BorderBrush="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,6" Width="260">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap">
                                <Run Text="Encerrar" /> <Run FontWeight="SemiBold" Text="{Binding Selected.Name, Mode=OneWay}" /><Run Text="? Trabalho não salvo nesse programa será perdido." />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ConfirmEndButton" Style="{StaticResource PrimaryButton}" Padding="12,5" Command="{Binding ConfirmEndCommand}" Content="Encerrar" />
                                <Button Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="8,0,0,0" Command="{Binding CancelEndCommand}" Content="Cancelar" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
