<UserControl x:Class="LeccorWindowsHealthCenter.App.Views.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeccorWindowsHealthCenter.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance Type=vm:WindowsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1100">
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Content="Verificação rápida"
                            Command="{Binding QuickCheckCommand}" AutomationProperties.Name="Executar verificação rápida da integridade do Windows" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Content="Verificação profunda (SFC)"
                            Command="{Binding FullCheckCommand}" AutomationProperties.Name="Executar verificação profunda com SFC e DISM ScanHealth" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancelar"
                            Command="{Binding CancelCommand}" Visibility="{Binding IsChecking, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Integridade do Windows" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Diagnóstico não destrutivo do Component Store (DISM), arquivos protegidos (SFC) e sistema de arquivos (CHKDSK)." />
                </StackPanel>
            </DockPanel>

            <!-- Barra de status / progresso ao executar -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsChecking, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>

            <!-- Card de laudo no topo (laudo primeiro) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasRun, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{Binding OverallAlertTitle}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding VerifiedAtText}" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding OverallAlertMessage}" />
                </DockPanel>
            </Border>

            <!-- Grid dos 3 pilares de integridade -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <!-- 1. DISM Component Store -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Caption}" Text="IMAGEM E REPOSITÓRIO" />
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,2,0,8" Text="Component Store" />
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ComponentStoreStatus}" />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ComponentStoreMessage}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- 2. SFC System Files -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Caption}" Text="ARQUIVOS PROTEGIDOS" />
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,2,0,8" Text="System Files (SFC)" />
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding SystemFilesStatus}" />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SystemFilesMessage}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- 3. CHKDSK Volume -->
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Caption}" Text="ESTRUTURA NTFS / DISCO" />
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,2,0,8" Text="File System (C:)" />
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding FileSystemStatus}" />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding FileSystemMessage}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Detalhes avançados (comandos executados e saídas brutas do console) -->
            <Expander Style="{StaticResource ModernExpander}" Header="Detalhes técnicos e comandos executados" Margin="0,8,0,0"
                      Visibility="{Binding Preferences.AdvancedMode, Converter={StaticResource VisibleWhen}}">
                <StackPanel Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="DISM /Online /Cleanup-Image" />
                            <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" Text="{Binding ComponentStoreCommand}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource ModernTextBox}" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Text="{Binding ComponentStoreOutput}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SFC /VERIFYONLY" />
                            <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" Text="{Binding SystemFilesCommand}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource ModernTextBox}" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Text="{Binding SystemFilesOutput}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CHKDSK C: (Somente Leitura)" />
                            <TextBlock Style="{StaticResource Caption}" FontFamily="Consolas" Text="{Binding FileSystemCommand}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource ModernTextBox}" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Text="{Binding FileSystemOutput}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>

